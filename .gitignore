*~
~$*

# Real tasks stay local; only the two example tasks are tracked.
/tasks/*
!/tasks/261011-example-il-progress/
!/tasks/2601-world-model1/
# Within the examples, outputs are rebuilt from slides.md; only listed tasks' PPTX/PDF are tracked.
# sources/ (papers, data, draft decks) is ignored above except in the completed example.
!/tasks/261011-example-il-progress/sources/
/tasks/*/*.pptx
/tasks/*/*.pdf
!tasks/2601-world-model1/*.pptx
!tasks/2601-world-model1/*.pdf
!/tasks/261011-example-il-progress/*.pptx
!/tasks/261011-example-il-progress/*.pdf
/tasks/*/.build/
/tasks/*/.rvppt-*.tmp
/tasks/*/plan/.rvppt-*.tmp
_workspace/

# Personal cover details; profile.example.yaml is the shared template.
/profile.yaml

# Template QA sources are reproducible; layout PNGs and manifests are tracked.
/docs/design/build/
/templates/examples/
# The five published Graphify files are tracked; local extraction state is not.
/graphify-out/.*
/graphify-out/cost.json
/graphify-out/manifest.json
/graphify-out/cache/
