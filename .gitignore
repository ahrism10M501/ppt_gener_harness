# Python / Node dependencies and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
.cache/
dist/
sources/

# Secrets, OS and editor scratch files
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
~$*

# Real tasks stay local; only the example task is tracked.
/tasks/*
!/tasks/261011-example-il-progress/
# sources/ (papers, data, draft decks) is ignored above except in the example.
!/tasks/261011-example-il-progress/sources/
/tasks/*/*.pptx
/tasks/*/*.pdf
!/tasks/261011-example-il-progress/*.pptx
!/tasks/261011-example-il-progress/*.pdf
/tasks/*/.build/
/tasks/*/.rvppt-*.tmp
/tasks/*/plan/.rvppt-*.tmp
_workspace/

# Personal cover details; profile.example.yaml is the shared template.
/profile.yaml

# Template QA sources are reproducible; layout PNGs and manifests are tracked.
/docs/design/build/
/templates/examples/
# The five published Graphify files are tracked; local extraction state is not.
/graphify-out/.*
/graphify-out/cost.json
/graphify-out/manifest.json
/graphify-out/cache/

# Agent worktrees are local checkouts, never content.
/.claude/worktrees/
